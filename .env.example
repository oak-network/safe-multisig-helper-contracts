# Private key for deployment (without 0x prefix)
# NEVER commit your actual private key! Keep it in .env which is gitignored
PRIVATE_KEY=your_private_key_here

# Optional: Celoscan API key for contract verification
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Networks:
# - Celo Mainnet: https://forno.celo.org (Chain ID: 42220)
# - Alfajores Testnet: https://alfajores-forno.celo-testnet.org (Chain ID: 44787)

# Get testnet CELO from: https://faucet.celo.org
# Celoscan API key from: https://celoscan.io/myapikey
